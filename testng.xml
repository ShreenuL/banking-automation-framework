<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Test Suite" parallel="classes" thread-count="2">

    <!-- Allure + Custom Listener -->
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="reporting.TestListener"/>
    </listeners>

    <!-- Smoke Tests -->
    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <packages>
            <package name="tests"/>
        </packages>

    </test>

    <!-- Regression Tests -->
    <test name="Regression Tests">

        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <packages>
            <package name="tests"/>
        </packages>

    </test>

    <!-- API Tests -->
    <test name="API Tests">

        <packages>
            <package name="api"/>
        </packages>

    </test>

</suite>